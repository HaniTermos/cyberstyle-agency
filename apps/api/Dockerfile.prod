# ==============================================================================
# CYBERSTYLE API - Production Multi-Stage Dockerfile
# Optimized for minimal image size, zero devDependencies, and non-root security.
# ==============================================================================

ARG BUILD_IMAGE=agencyproject-api:latest

# --- Stage 1: TypeScript Production Build & Dependency Pruning ---
FROM ${BUILD_IMAGE} AS builder
WORKDIR /app

COPY . .
RUN npx tsc packages/config/src/schemas.ts
RUN npx prisma generate
RUN npm run build --workspace=@cyberstyle/api
RUN npm prune --omit=dev --legacy-peer-deps
RUN mkdir -p /app/node_modules/@cyberstyle && ln -sf /app/packages/config /app/node_modules/@cyberstyle/config

# --- Stage 2: Minimal Production Runner ---
FROM node:22-alpine AS runner
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Create dedicated unprivileged user for container security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 expressjs

# Copy pruned runtime dependencies & compiled JavaScript
COPY --from=builder --chown=expressjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=expressjs:nodejs /app/packages ./packages
COPY --from=builder --chown=expressjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=expressjs:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=expressjs:nodejs /app/apps/api/package.json ./apps/api/package.json

RUN mkdir -p /app/node_modules/@cyberstyle && ln -sf /app/packages/config /app/node_modules/@cyberstyle/config

USER expressjs

WORKDIR /app/apps/api
EXPOSE 4000

CMD ["node", "dist/index.js"]
