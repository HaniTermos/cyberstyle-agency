{
  "name": "cyberstyle-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready agency website, client portal, and internal operations platform for CYBERSTYLE LLC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e --workspace=@cyberstyle/api",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.4",
    "prettier": "^3.5.1",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.2"
  },
  "overrides": {
    "qs": "^6.16.0",
    "sharp": "^0.35.4",
    "postcss": "^8.5.28",
    "nodemailer": "^9.1.1",
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
