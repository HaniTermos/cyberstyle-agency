# ==============================================================================
# CYBERSTYLE LLC - Environment Variables Configuration Template
# Domain: https://cyberstyle.net
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & GENERAL SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development # Options: development, test, production
PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL 16) & CACHING/QUEUES (Redis 7)
# ------------------------------------------------------------------------------
# PostgreSQL connection format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/cyberstyle_db?schema=public"
REDIS_URL="redis://:redis_secure_password@localhost:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION, SECURITY & SEEDING (Argon2id + TOTP 2FA + AES-256-GCM)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change_me_to_a_secure_random_64_character_string_for_production"
SESSION_SECRET="change_me_to_another_secure_random_string_for_session_encryption"
ENCRYPTION_KEY="change_me_to_32_byte_base64_encryption_key_for_db_fields"
JWT_EXPIRATION="7d"
COOKIE_DOMAIN="localhost" # Set to .cyberstyle.net in production
CORS_ORIGINS="http://localhost:3000,https://cyberstyle.net,https://admin.cyberstyle.net"

# Super Admin Initial Seeding Credentials (reads from env, dev fallback only)
SEED_SUPER_ADMIN_EMAIL="admin@cyberstyle.net"
SEED_SUPER_ADMIN_PASSWORD="Admin123456!"

# Google OAuth SSO (Self-hosted client config)
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (Nodemailer SMTP + Transactional Queues)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.mailgun.org" # Amazon SES, Postmark, Mailgun, or SendGrid SMTP
SMTP_PORT=587
SMTP_SECURE=false # true for port 465, false for 587
SMTP_USER="postmaster@mg.cyberstyle.net"
SMTP_PASSWORD="your_smtp_password"
EMAIL_FROM="CYBERSTYLE <hello@cyberstyle.net>"
EMAIL_REPLY_TO="support@cyberstyle.net"
ADMIN_NOTIFICATION_EMAILS="admin@cyberstyle.net,lead-alerts@cyberstyle.net"

# ------------------------------------------------------------------------------
# 5. PAYMENTS & INVOICING (Stripe + Webhooks)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
INVOICE_PDF_PATH="./storage/invoices"

# ------------------------------------------------------------------------------
# 6. ASSET & DOCUMENT STORAGE (Local or S3-Compatible)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="local" # Options: local, s3, minio, r2
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="cyberstyle-deliverables"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 7. AI ENGINE & AUTOMATION (Google Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
AI_LEAD_SCORING_ENABLED=true
AI_SUMMARY_ENABLED=true

# ------------------------------------------------------------------------------
# 8. ANALYTICS & TECHNICAL SEO (Public routes only)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 9. MONITORING & ERROR LOGGING
# ------------------------------------------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="info" # Options: error, warn, info, http, debug
