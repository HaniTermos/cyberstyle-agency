# ==============================================================================
# CYBERSTYLE LLC - Environment Variables Configuration Template (.env.example)
# Domain: https://cyberstyle.net
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & GENERAL SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development # Options: development, test, staging, production
PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
INTERNAL_API_URL=http://api:4000/api

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL 16) & CACHING/QUEUES (Redis 7)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_LOCAL_POSTGRES_PASSWORD
POSTGRES_DB=db_agency
# Host-facing format:
DATABASE_URL="postgresql://postgres:CHANGE_THIS_LOCAL_POSTGRES_PASSWORD@localhost:5432/db_agency?schema=public"

REDIS_PASSWORD=CHANGE_THIS_LOCAL_REDIS_PASSWORD
# Host-facing format:
REDIS_URL="redis://:CHANGE_THIS_LOCAL_REDIS_PASSWORD@localhost:6379"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change_me_to_a_secure_random_64_character_hex_string_for_production"
SESSION_SECRET="change_me_to_another_secure_random_64_character_hex_string_for_production"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://cyberstyle.net"
ADMIN_NOTIFICATION_EMAILS="admin@cyberstyle.net"

# ------------------------------------------------------------------------------
# 4. PAYMENTS & INVOICING (Stripe Sandbox Fixtures)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_mock_stripe_key"
STRIPE_WEBHOOK_SECRET="whsec_test_mock_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_mock_stripe_pubkey"

# ------------------------------------------------------------------------------
# 5. OPTIONAL SERVICES (Email SMTP, AI, Analytics)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp_user"
SMTP_PASSWORD="smtp_password"
EMAIL_FROM="CYBERSTYLE <hello@cyberstyle.net>"
EMAIL_REPLY_TO="support@cyberstyle.net"

GEMINI_API_KEY=""
NEXT_PUBLIC_GA_ID=""
